extends includes/layout.pug

block content
  include ./includes/mixins/post-ui.pug
  - const totoroPostDates = []
  - site.posts.sort('date', -1).each(function(article){ totoroPostDates.push(date(article.date, 'YYYY-MM-DD')) })
  #recent-posts.recent-posts
    details.home-gallery-panel
      summary.home-gallery-summary
        .home-gallery-summary__copy
          span.home-gallery-summary__eyebrow Visual Shelf
          h2.home-gallery-summary__title 分享生活照
          p.home-gallery-summary__desc 学习的过程中不要忘了记录生活
        .home-gallery-summary__action
          span.home-gallery-summary__hint 点击展开
          i.fas.fa-plus.home-gallery-summary__icon
      .home-gallery-body
        .home-gallery-wall
          a.home-gallery-card.home-gallery-card--hero(href='/assets/1.jpg' data-fancybox='home-gallery' title='Quiet view')
            img(src='/assets/1.jpg' alt='Quiet view')
            span.home-gallery-card__label Quiet view
          a.home-gallery-card.home-gallery-card--tall(href='/assets/2.jpg' data-fancybox='home-gallery' title='Soft weather')
            img(src='/assets/2.jpg' alt='Soft weather')
            span.home-gallery-card__label Soft weather
          a.home-gallery-card(href='/assets/3.jpg' data-fancybox='home-gallery' title='Slow walk')
            img(src='/assets/3.jpg' alt='Slow walk')
            span.home-gallery-card__label Slow walk
          a.home-gallery-card(href='/assets/4.jpg' data-fancybox='home-gallery' title='Clean air')
            img(src='/assets/4.jpg' alt='Clean air')
            span.home-gallery-card__label Clean air
          a.home-gallery-card.home-gallery-card--tall(href='/assets/5.jpg' data-fancybox='home-gallery' title='Green hour')
            img(src='/assets/5.jpg' alt='Green hour')
            span.home-gallery-card__label Green hour
          a.home-gallery-card(href='/assets/6.jpg' data-fancybox='home-gallery' title='Open sky')
            img(src='/assets/6.jpg' alt='Open sky')
            span.home-gallery-card__label Open sky
          a.home-gallery-card(href='/assets/7.jpg' data-fancybox='home-gallery' title='Little pause')
            img(src='/assets/7.jpg' alt='Little pause')
            span.home-gallery-card__label Little pause
          a.home-gallery-card(href='/assets/8.jpg' data-fancybox='home-gallery' title='Long memory')
            img(src='/assets/8.jpg' alt='Long memory')
            span.home-gallery-card__label Long memory
          a.home-gallery-card(href='/assets/9.jpg' data-fancybox='home-gallery' title='Golden hour')
            img(src='/assets/9.jpg' alt='Golden hour')
            span.home-gallery-card__label Golden hour
    .recent-post-item.recent-post-item--totoro
      section.home-totoro-panel
        .totoro-board-host
          script.totoro-board-data(type='application/json')!= JSON.stringify(totoroPostDates)
    .home-dashboard-row
      .home-terminal-widget
        .terminal-window
          .terminal-titlebar
            .terminal-dots
              span.terminal-dot--red
              span.terminal-dot--yellow
              span.terminal-dot--green
            .terminal-title-text chagumu@blog:~
            .terminal-title-controls
              span.terminal-minimize
              span.terminal-maximize
          .terminal-body
            .terminal-ascii-art
              pre.terminal-ascii
                |  ██████╗██╗  ██╗███████╗███╗   ██╗
                | ██╔════╝██║  ██║██╔════╝████╗  ██║
                | ██║     ███████║█████╗  ██╔██╗ ██║
                | ██║     ██══██║██╔══╝  ██║╚██╗██║
                | ╚██████╗██║  ██║███████╗██║ ████║
                |  ╚═════╝╚═╝  ╚═╝╚══════╝╚═╝  ╚═══╝
            .terminal-output#terminal-output
            .terminal-input-line
              span.terminal-prompt $&nbsp;
              input.terminal-input#terminal-input(type='text' autocomplete='off' spellcheck='false' placeholder='输入 help 查看可用命令...')
      .home-status-widget
        .status-panel
          .status-panel__header
            .status-panel__title
              i.fas.fa-microchip
              span SYS_MONITOR
            .status-panel__uptime
              span.uptime-label uptime
              span#status-uptime 00:00:00
          .status-panel__clock
            span#status-clock 00:00:00
          .status-metrics
            .status-metric
              .status-metric__label
                span CPU.LOAD
                span#cpu-value 0%
              .status-metric__bar
                .status-metric__fill#cpu-bar
            .status-metric
              .status-metric__label
                span MEM.USAGE
                span#mem-value 0%
              .status-metric__bar
                .status-metric__fill#mem-bar
            .status-metric
              .status-metric__label
                span NET.SIGNAL
                span#net-value 0%
              .status-metric__bar
                .status-metric__fill#net-bar
          .status-panel__wave
            canvas#status-wave-canvas
          .status-panel__footer
            span.status-panel__telemetry // telemetry · realtime
            span#status-tx tx 0 kb/s
    //- #bber-talk
    //-   link(rel="stylesheet", href="/static/css/bbtalk.css")
    //-   script(src='/static/js/timeago.min.js')
    //-   script(src='/static/js/bbtalk.js')
    +postUI
    include includes/pagination.pug
